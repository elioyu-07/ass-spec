{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayer.dev/ass-spec/agent-boundaries.schema.json",
  "title": "ass-spec Agent semantic boundary definitions",
  "description": "Single source for the page-compatible checkpoint and finalization schemas registered by ass-spec.",
  "type": "object",
  "$defs": {
    "sourceEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_chunk_id",
        "document_path",
        "source_digest",
        "start_line",
        "end_line"
      ],
      "properties": {
        "source_chunk_id": {
          "type": "string",
          "minLength": 1,
          "description": "Copy sourceChunks[].source_chunk_id verbatim."
        },
        "document_path": {
          "type": "string",
          "minLength": 1,
          "description": "Copy sourceChunks[].document_path verbatim."
        },
        "source_digest": {
          "type": "string",
          "minLength": 1,
          "description": "Copy sourceChunks[].source_digest verbatim."
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Copy sourceChunks[].start_line verbatim."
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Copy sourceChunks[].end_line verbatim."
        }
      }
    },
    "checklistReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status",
        "note",
        "evidence_refs",
        "applicability",
        "observation",
        "gap",
        "impact",
        "recommendation",
        "owner",
        "next_action",
        "confidence"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^CHK-(0[1-9]|1[0-8])$"
        },
        "status": {
          "enum": ["PASS", "REWORK", "ESCALATE", "UNVERIFIED"]
        },
        "note": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceEvidenceRef"}
        },
        "applicability": {
          "enum": ["APPLICABLE", "NOT_APPLICABLE", "CONDITIONAL", "UNVERIFIED"]
        },
        "observation": {"type": "string", "minLength": 1},
        "gap": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "finding_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]}
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "REWORK"}}
          },
          "then": {
            "required": ["finding_refs"],
            "properties": {"finding_refs": {"minItems": 1}}
          }
        }
      ]
    },
    "candidateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "candidate_ids"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["CONFIRMED", "SUPPRESSED", "MERGED", "UNVERIFIED"]},
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "severity": {"enum": ["P1", "P2", "P3"]},
        "object_id": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "pattern": "^CHK-(0[1-9]|1[0-8])$"},
        "gap": {"type": "string", "minLength": 1},
        "observed_fact": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "closure_evidence": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "review_note": {"type": "string", "minLength": 1},
        "merged_into": {"type": "string", "minLength": 1},
        "affected_elements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceEvidenceRef"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "CONFIRMED"}}
          },
          "then": {
            "required": [
              "severity",
              "object_id",
              "dimension",
              "gap",
              "observed_fact",
              "impact",
              "recommendation",
              "closure_evidence",
              "evidence",
              "affected_elements",
              "owner",
              "next_action",
              "confidence",
              "evidence_refs"
            ]
          },
          "else": {
            "required": ["review_note"]
          }
        },
        {
          "if": {
            "required": ["status"],
            "properties": {"status": {"const": "MERGED"}}
          },
          "then": {"required": ["merged_into"]}
        }
      ]
    },
    "crossDocumentEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "source_chunk_id",
        "document_path",
        "source_digest",
        "start_line",
        "end_line",
        "excerpt"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "source_chunk_id": {"type": "string", "minLength": 1},
        "document_path": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "crossDocumentDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "status",
        "candidate_ids",
        "semantic_type",
        "object_id",
        "dimension",
        "gap",
        "impact",
        "recommendation",
        "relationship_id",
        "document_ids",
        "affected_elements",
        "resolution_owner",
        "next_action",
        "evidence",
        "evidence_refs"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["CONFIRMED", "UNVERIFIED"]},
        "candidate_ids": {"type": "array", "maxItems": 0},
        "semantic_type": {
          "enum": ["ambiguity", "conflict", "contradiction", "drift", "unverified_dependency"]
        },
        "severity": {"enum": ["P1", "P2", "P3"]},
        "object_id": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "pattern": "^CHK-(0[1-9]|1[0-8])$"},
        "gap": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "closure_evidence": {"type": "string", "minLength": 1},
        "review_note": {"type": "string", "minLength": 1},
        "relationship_id": {"type": "string", "minLength": 1},
        "document_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "affected_elements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "resolution_owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/crossDocumentEvidenceRef"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["semantic_type"],
            "properties": {"semantic_type": {"const": "unverified_dependency"}}
          },
          "then": {
            "required": ["review_note"],
            "properties": {"status": {"const": "UNVERIFIED"}}
          },
          "else": {
            "required": ["severity", "closure_evidence"],
            "properties": {"status": {"const": "CONFIRMED"}}
          }
        }
      ]
    },
    "crossDocumentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "outcome", "note", "decisions"],
      "properties": {
        "relationship_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["COMPATIBLE", "FINDING", "UNVERIFIED"]},
        "note": {"type": "string", "minLength": 1},
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/crossDocumentDecision"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": {"outcome": {"const": "COMPATIBLE"}}
          },
          "then": {"properties": {"decisions": {"maxItems": 0}}},
          "else": {"properties": {"decisions": {"minItems": 1}}}
        }
      ]
    },
    "reviewerOriginDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "status",
        "candidate_ids",
        "severity",
        "object_id",
        "dimension",
        "gap",
        "observed_fact",
        "impact",
        "recommendation",
        "closure_evidence",
        "evidence",
        "affected_elements",
        "owner",
        "next_action",
        "confidence",
        "evidence_refs"
      ],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "status": {"const": "CONFIRMED"},
        "candidate_ids": {"type": "array", "maxItems": 0},
        "severity": {"enum": ["P1", "P2", "P3"]},
        "object_id": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "pattern": "^CHK-(0[1-9]|1[0-8])$"},
        "gap": {"type": "string", "minLength": 1},
        "observed_fact": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "closure_evidence": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "affected_elements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceEvidenceRef"}
        }
      }
    },
    "candidateCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions"],
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candidateDecision"}
        }
      }
    },
    "checklistCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checklist_review"],
      "properties": {
        "checklist_review": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checklistReview"}
        }
      }
    },
    "crossDocumentCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cross_document_review"],
      "properties": {
        "cross_document_review": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/crossDocumentReview"}
        }
      }
    },
    "finalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness_context"],
      "properties": {
        "readiness_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mandatory_dimensions_checked",
            "unresolved_blockers",
            "escalations"
          ],
          "properties": {
            "mandatory_dimensions_checked": {"type": "boolean"},
            "unresolved_blockers": {"type": "boolean"},
            "escalations": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "reviewer_origin_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/reviewerOriginDecision"}
        }
      }
    }
  }
}
